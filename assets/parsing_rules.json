{
  "rules": [
    {
      "id": "generic_bank_sms",
      "priority": 1,
      "amount_regex": "(?:(?:₹|INR|Rs\\.?|\\$)\\s?)?([0-9]{1,3}(?:,[0-9]{3})*(?:\\.[0-9]{1,2})?|[0-9]+(?:\\.[0-9]{1,2})?)",
      "date_regex": "(\\d{1,2}\\/\\d{1,2}\\/\\d{2,4}|\\d{1,2}-\\d{1,2}-\\d{2,4})",
      "payee_regex": "(?:to|at|from)\\s+([A-Za-z0-9\\s\\.]+?)(?:\\s+(?:on|using|via|ref|bal|txn)|$|\\.)",
      "keywords_spent": ["debited", "paid", "sent", "purchase", "spent", "withdrawn"],
      "keywords_received": ["credited", "received", "refund", "deposited", "added"]
    },
    {
      "id": "upi_transaction",
      "priority": 2,
      "amount_regex": "(?:Paid|Sent)\\s+(?:(?:₹|INR|Rs\\.?)\\s?)?([0-9,.]+)",
      "payee_regex": "(?:to)\\s+([A-Za-z0-9\\s]+?)(?:\\s+on|\\.|API|Ref)",
      "keywords_spent": ["paid", "sent"],
      "keywords_received": []
    }
  ]
}
